# ==============================================================================
# ILBI Backend Environment Configuration (.env.example)
# Copy this file to .env and replace dummy values with your actual configuration.
# ==============================================================================

# Generate a secret locally and paste it here; never commit the real value:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Django Debug Mode (True for development, False for production)
DJANGO_DEBUG=False

# Local synthetic demo accounts only. The server refuses this flag with DEBUG=False.
LOCAL_DEMO_LOGIN_ENABLED=False
# Used by seed_demo_platform on an empty local database; supply your own 12+ character password.
ILBI_DEMO_PASSWORD=

# Allowed Hosts (comma-separated domains/IPs)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,ilbi,nginx

# Database Configuration (PostgreSQL)
DB_NAME=ilbi_db
DB_USER=ilbi_admin
DB_PASSWORD=change_me_in_production
DB_HOST=postgres
DB_PORT=5432
POSTGRES_DB=ilbi_db
POSTGRES_USER=ilbi_admin
POSTGRES_PASSWORD=change_me_in_production

# Internal Service Shared Token (for secure microservice & Telegram bot communication)
INTERNAL_SERVICE_TOKEN=example-internal-service-token-change-in-production

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token

# Redis & Celery Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
C_FORCE_ROOT=1

# Gunicorn & Server Concurrency Settings
GUNICORN_WORKERS=3
GUNICORN_WORKER_CLASS=gevent
GUNICORN_LOG_LEVEL=info
GEVENT_RESOLVER=ares

# Frontend URL (used in password reset & activation email links)
FRONTEND_URL=http://localhost:5173

# Email / SMTP Configuration
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=change_me_smtp_password
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL="ILBI <noreply@ilbi.uz>"

# MinIO / S3 Object Storage Configuration (Optional)
USE_MINIO=False
MINIO_ROOT_USER=ilbi_minio
MINIO_ROOT_PASSWORD=minio_secret_change_in_prod
MINIO_BUCKET_NAME=ilbi-media
MINIO_ENDPOINT=http://minio:9000

# Support contacts and verified private Telegram operator recipients (comma separated phones).
SUPPORT_PHONE=+998770212149
SUPPORT_TELEGRAM_USERNAME=abdulxadiy_0
SUPPORT_OPERATOR_PHONES=+998770212149

# Existing deployments may retain their support throttle namespace during the compatibility period.
SUPPORT_CACHE_KEY_PREFIX=ilbi_support
