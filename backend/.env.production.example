# Copy to backend/.env.production on the server. Never reuse development secrets.
# docker-compose.prod.yml sets production settings, hosts, HTTPS origin and Redis URLs.
DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_DEBUG=False
LOCAL_DEMO_LOGIN_ENABLED=False
GUNICORN_RELOAD=False
ALLOWED_HOSTS=ilbi.uz,ilbi
FRONTEND_URL=https://ilbi.uz
SECURE_HSTS_SECONDS=3600
# Generate a unique random secret of at least 50 characters.
DJANGO_SECRET_KEY=

DB_NAME=ilbi_db
DB_USER=ilbi_admin
DB_PASSWORD=replace-with-the-same-password-as-root-production-env
DB_HOST=postgres
DB_PORT=5432
# Production rate-limit counters share this Redis across workers/replicas.
# Django cache keys use a production/domain prefix, separate from support and login keys.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
GUNICORN_WORKERS=2
GUNICORN_WORKER_CLASS=gevent
GUNICORN_LOG_LEVEL=info

INTERNAL_SERVICE_TOKEN=
TELEGRAM_BOT_TOKEN=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=resend
# Use the existing Resend API key; never commit the real value.
EMAIL_HOST_PASSWORD=
# Activate this sender only after ilbi.uz is Verified in Resend.
DEFAULT_FROM_EMAIL="ILBI <noreply@ilbi.uz>"

USE_MINIO=False
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_NAME=ilbi-media
MINIO_ENDPOINT=http://minio:9000

SUPPORT_PHONE=+998770212149
SUPPORT_TELEGRAM_USERNAME=abdulxadiy_0
SUPPORT_OPERATOR_PHONES=+998770212149
