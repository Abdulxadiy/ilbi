{
  "cli": { "appVersionSource": "local" },
  "build": {
    "apk": {
      "distribution": "internal",
      "credentialsSource": "local",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_DESIGN_PREVIEW": "0", "EXPO_PUBLIC_UPDATE_PREVIEW": "0" }
    },
    "play-store": {
      "distribution": "store",
      "credentialsSource": "local",
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_DESIGN_PREVIEW": "0", "EXPO_PUBLIC_UPDATE_PREVIEW": "0" }
    },
    "ios-test": {
      "distribution": "internal",
      "credentialsSource": "remote",
      "env": { "EXPO_PUBLIC_DESIGN_PREVIEW": "0", "EXPO_PUBLIC_UPDATE_PREVIEW": "0" }
    },
    "ios-store": {
      "distribution": "store",
      "credentialsSource": "remote",
      "env": { "EXPO_PUBLIC_DESIGN_PREVIEW": "0", "EXPO_PUBLIC_UPDATE_PREVIEW": "0" }
    },
    "ios-simulator": {
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "EXPO_PUBLIC_DESIGN_PREVIEW": "0", "EXPO_PUBLIC_UPDATE_PREVIEW": "0" }
    }
  },
  "submit": { "ios-store": {}, "play-store": {} }
}
