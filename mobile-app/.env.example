# All EXPO_PUBLIC variables are public application configuration, never secrets.
# Browser requests use the same-origin /api/v1 proxy by default.
# For a real phone on the same LAN, set this to your development machine's address:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8082/api/v1
# Development-only, isolated design data; never enables a real financial write.
EXPO_PUBLIC_DESIGN_PREVIEW=0
