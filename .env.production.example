# Production Compose inputs only. Copy to .env.production on the server.
# Keep COMPOSE_PROJECT_NAME unchanged when upgrading an existing installation.
COMPOSE_PROJECT_NAME=ilbi-platform
PUBLIC_HOST=ilbi.uz
# Use 127.0.0.1 during private bootstrap; enable public binding only after real TLS.
EDGE_BIND_ADDRESS=0.0.0.0
# Set this to the attached Static IPv4 before running ops/enable_https.sh.
EXPECTED_PUBLIC_IPV4=replace-with-server-ipv4
# Absolute host path; must contain the real fullchain.pem and privkey.pem files.
# The directory is mounted read-only and will not be created automatically.
TLS_CERT_DIR=/etc/ilbi/tls
# Start with one hour; increase only after HTTPS and certificate renewal are verified.
SECURE_HSTS_SECONDS=3600

POSTGRES_DB=ilbi_db
POSTGRES_USER=ilbi_admin
POSTGRES_PASSWORD=replace-with-a-unique-database-password

# Optional MinIO profile. Use matching credentials in backend/.env.production.
MINIO_ROOT_USER=replace-with-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-unique-minio-password
