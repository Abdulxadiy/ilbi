# ==============================================================================
# ILBI Platform Root Environment Configuration (.env.example)
# Copy this file to .env before running docker compose or local services.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database (used by docker-compose and backend services)
# ------------------------------------------------------------------------------
# Database name
POSTGRES_DB=ilbi_db
# Database superuser/app user
POSTGRES_USER=ilbi_admin
# Database user password
POSTGRES_PASSWORD=change_me_in_production
# Database host for backend connection (use 'postgres' in docker, 'localhost' for local)
DB_HOST=postgres
# Database port
DB_PORT=5432
# Database name alias used by Django settings
DB_NAME=ilbi_db
# Database user alias used by Django settings
DB_USER=ilbi_admin
# Database password alias used by Django settings
DB_PASSWORD=change_me_in_production

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
# Generate a secret locally and paste it into backend/.env; never commit the real value:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Enable or disable debug mode (False for production)
DJANGO_DEBUG=False
# Comma-separated list of allowed hostnames/IPs
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,ilbi,nginx

# ------------------------------------------------------------------------------
# Microservice & Telegram Bot Communication
# ------------------------------------------------------------------------------
# Shared internal service token for authenticating internal requests
INTERNAL_SERVICE_TOKEN=example-internal-service-token-change-in-production
# Telegram Bot API token shared by Django notifications and the 2FA bot service
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
# Internal registration URL called by the 2FA Telegram bot
ILBI_INTERNAL_URL=http://ilbi:8000/api/v1/internal/telegram/register/
# Shop integration internal URL (optional)
SHOP_INTERNAL_URL=http://shop:8001/internal/telegram/link/

# ------------------------------------------------------------------------------
# Redis & Celery Task Queue
# ------------------------------------------------------------------------------
# Redis host (use 'redis' in docker, 'localhost' for local)
REDIS_HOST=redis
# Redis port
REDIS_PORT=6379
# Redis database index
REDIS_DB=0
# Full connection URL for Redis cache and locks
REDIS_URL=redis://redis:6379/0
# Celery message broker connection URL
CELERY_BROKER_URL=redis://redis:6379/1
# Celery task result backend URL
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Force Celery worker execution as root inside docker container
C_FORCE_ROOT=1

# ------------------------------------------------------------------------------
# Gunicorn & Application Server
# ------------------------------------------------------------------------------
# Number of Gunicorn worker processes
GUNICORN_WORKERS=3
# Gunicorn worker process class (e.g. gevent)
GUNICORN_WORKER_CLASS=gevent
# Gunicorn log verbosity
GUNICORN_LOG_LEVEL=info
# Gevent resolver engine
GEVENT_RESOLVER=ares

# ------------------------------------------------------------------------------
# Frontend & Email Configuration
# ------------------------------------------------------------------------------
# Public URL of the frontend (for password reset and activation links)
FRONTEND_URL=http://localhost:5173
# Vite reverse proxy target for API requests in dev mode
VITE_API_TARGET=http://nginx:80
# SMTP hostname for outgoing emails
EMAIL_HOST=smtp.example.com
# SMTP port (587 for TLS, 465 for SSL)
EMAIL_PORT=587
# Use TLS for SMTP connection
EMAIL_USE_TLS=True
# Use SSL for SMTP connection
EMAIL_USE_SSL=False
# SMTP authentication username
EMAIL_HOST_USER=noreply@example.com
# SMTP authentication password
EMAIL_HOST_PASSWORD=change_me_smtp_password
# Django email backend class
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Sender address shown on outgoing emails
DEFAULT_FROM_EMAIL="ILBI <noreply@ilbi.uz>"

# ------------------------------------------------------------------------------
# Object Storage (MinIO / S3)
# ------------------------------------------------------------------------------
# Flag to enable MinIO / S3 storage instead of local filesystem
USE_MINIO=False
# MinIO root admin username / S3 Access Key ID
MINIO_ROOT_USER=ilbi_minio
# MinIO root admin password / S3 Secret Access Key
MINIO_ROOT_PASSWORD=minio_secret_change_in_prod
# MinIO S3 bucket name for product images and media
MINIO_BUCKET_NAME=ilbi-media
# MinIO S3 API endpoint URL
MINIO_ENDPOINT=http://minio:9000

# Set these to existing names only when upgrading an existing Docker project.
COMPOSE_PROJECT_NAME=ilbi-platform
# ILBI_NETWORK_NAME=
# ILBI_VENV_VOLUME=

# Existing deployments may retain their support throttle namespace during the compatibility period.
SUPPORT_CACHE_KEY_PREFIX=ilbi_support

# For an upgrade that reuses existing named resources, set these true with the names above.
ILBI_NETWORK_EXTERNAL=false
ILBI_VENV_EXTERNAL=false

# Change when a native Vite server already occupies 5173.
FRONTEND_PORT=5173

# Optional mobile development profile: docker compose --profile mobile up -d --build --no-deps mobile
MOBILE_METRO_PORT=8081
MOBILE_PREVIEW_PORT=8082
MOBILE_BIND_ADDRESS=127.0.0.1
MOBILE_DEV_HOST=127.0.0.1
# 1 = explicit synthetic design preview; 0 = real backend/login (requires backend services).
MOBILE_DESIGN_PREVIEW=1
# Browser defaults to the same-origin API proxy. Set a reachable API URL for native devices.
MOBILE_API_URL=
