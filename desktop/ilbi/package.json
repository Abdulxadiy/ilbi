{
  "name": "ilbi-desktop",
  "productName": "ILBI",
  "version": "1.4.0",
  "private": true,
  "description": "ILBI offline savdo dasturi",
  "author": "ILBI",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:ui": "npm --prefix ../../frontend/ilbi run build",
    "dist:win": "node build.cjs",
    "dist:linux": "node build-linux.cjs",
    "pack": "npm run build:ui && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "uz.ilbi.desktop",
    "productName": "ILBI",
    "artifactName": "ILBI-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "runtime.cjs",
      "services.cjs",
      "document-sharing.cjs",
      "preload.cjs",
      "setup.html",
      "setup.js",
      "setup.css",
      "icon.ico",
      "application.cjs",
      "updater.cjs",
      "public-errors.cjs",
      "login-credentials.cjs",
      "proxy.cjs",
      "pairing.cjs",
      "pairing-manager.cjs",
      "session-lock.cjs",
      "backups.cjs",
      "draft-backup.cjs",
      "build-info.json",
      "linux-update-helper.cjs",
      "update-helper-preload.cjs",
      "apply-linux-update.py",
      "update.html",
      "update.css",
      "update-window.js"
    ],
    "extraResources": [
      {
        "from": "../../frontend/ilbi/dist",
        "to": "ui"
      }
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker",
      "signExecutable": false,
      "icon": "icon.ico",
      "extraResources": [
        {
          "from": "icon.ico",
          "to": "ilbi-desktop-rounded.ico"
        },
        {
          "from": "resources/backend",
          "to": "backend"
        },
        {
          "from": "resources/postgres",
          "to": "postgres"
        }
      ]
    },
    "linux": {
      "target": "dir",
      "executableName": "ilbi",
      "category": "Office",
      "icon": "../../frontend/ilbi/public/brand/ilbi-desktop-512.png",
      "extraResources": [
        {
          "from": "../../frontend/ilbi/public/brand/ilbi-desktop-512.png",
          "to": "ilbi-desktop.png"
        },
        {
          "from": "resources-linux/backend",
          "to": "backend"
        },
        {
          "from": "resources-linux/postgres",
          "to": "postgres"
        }
      ]
    },
    "nsis": {
      "script": "installer.nsi",
      "installerLanguages": [
        "en_US"
      ],
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    },
    "asarUnpack": [
      "apply-linux-update.py"
    ]
  }
}
